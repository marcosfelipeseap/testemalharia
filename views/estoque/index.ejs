<style>
    .folder-card { cursor: pointer; transition: all 0.2s ease-in-out; border: 2px solid transparent; }
    .folder-card:hover { transform: translateY(-5px); box-shadow: 0 .5rem 1.5rem rgba(13, 110, 253, 0.15)!important; border-color: #0d6efd; background-color: #f8fbff !important; }
    .folder-card-warning:hover { box-shadow: 0 .5rem 1.5rem rgba(255, 193, 7, 0.15)!important; border-color: #ffc107; background-color: #fffdf5 !important; }
    .folder-card-sede { border-color: #0d6efd !important; background-color: #f0f6ff !important; }

    .produto-card-quadrado { aspect-ratio: 1 / 1; display: flex; flex-direction: column; justify-content: center; align-items: center; transition: all 0.2s ease; border: 2px solid #e9ecef; }
    .produto-card-quadrado:hover { border-color: #198754; background-color: #f8fff9 !important; transform: scale(1.04); box-shadow: 0 .5rem 1rem rgba(25, 135, 84, 0.15)!important; }
    .produto-qtde { font-size: 2.5rem; line-height: 1; }
    .produto-desc { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
    
    .search-box { max-width: 350px; }
    input[type=number]::-webkit-inner-spin-button, input[type=number]::-webkit-outer-spin-button { -webkit-appearance: none; margin: 0; }
    .fade-out-row { opacity: 0; transform: translateX(20px); transition: all 0.4s ease; }
</style>

<div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-4 border-bottom">
    <h1 class="h2"><i class="bi bi-boxes text-success"></i> Estoque Consolidado</h1>
    <a href="/estoque/historico" class="btn btn-outline-primary shadow-sm fw-bold">
        <i class="bi bi-clock-history"></i> Histórico de Entregas e Transferências
    </a>
</div>

<% if (locals.user && user.nivel >= 3 && typeof transferenciasPendentes !== 'undefined' && transferenciasPendentes.length > 0) { %>
    <div id="alerta-aprovacoes" class="alert alert-warning border-warning shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-2 mb-md-0">
            <i class="bi bi-shield-lock-fill text-warning fs-5 me-2"></i>
            <strong class="text-dark">Aprovação Necessária:</strong> Existem <span id="contador-pendencias"><%= transferenciasPendentes.length %></span> lote(s) aguardando sua confirmação para saída.
        </div>
        <button class="btn btn-warning fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAprovacoes">
            <i class="bi bi-list-check"></i> Avaliar Pendências
        </button>
    </div>
<% } %>

<% if (locals.user && user.nivel < 3 && typeof minhasPendencias !== 'undefined' && (minhasPendencias.length > 0 || meuHistorico.length > 0)) { %>
    <div class="alert alert-info border-info shadow-sm d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4">
        <div class="mb-2 mb-md-0">
            <i class="bi bi-info-circle-fill text-info fs-5 me-2"></i>
            <strong class="text-dark">Status das Solicitações:</strong> Você tem <b><%= minhasPendencias.length %></b> envio(s) em análise e <b id="contador-historico-badge"><%= meuHistorico.length %></b> notificação(ões) nova(s).
        </div>
        <button class="btn btn-info fw-bold text-white shadow-sm" data-bs-toggle="modal" data-bs-target="#modalAcompanhamento">
            <i class="bi bi-search"></i> Acompanhar Envios
        </button>
    </div>
<% } %>

<% if (estoque.length === 0) { %>
    <div class="alert alert-warning text-center shadow-sm py-4">
        <i class="bi bi-exclamation-triangle fs-1 text-warning d-block mb-2"></i>
        <h5 class="fw-bold">Nenhuma malharia vinculada</h5>
        <p class="mb-0 text-muted">Você não possui malharias atribuídas para visualizar o estoque.</p>
    </div>
<% } else { %>
    
    <div id="view-malharias" class="view-section">
        <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
            <h5 class="text-secondary m-0"><i class="bi bi-1-circle"></i> Selecione uma Oficina:</h5>
            <div class="input-group search-box shadow-sm">
                <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar malharia..." onkeyup="pesquisarCards(this, 'lista-malharias')">
            </div>
        </div>

        <div class="row g-4" id="lista-malharias">
            <% estoque.forEach(function(malharia) { %>
                <div class="col-sm-6 col-md-4 col-lg-3 item-pesquisavel" data-search="<%= malharia.nome.toLowerCase() %> <%= malharia.tipo ? malharia.tipo.toLowerCase() : '' %>">
                    <div class="card h-100 shadow-sm folder-card <%= malharia.isSede ? 'folder-card-sede' : 'bg-white' %>" onclick="abrirProcessos('<%= malharia.id %>')">
                        <div class="card-body text-center d-flex flex-column justify-content-center align-items-center py-4">
                            <% if (malharia.isSede) { %>
                                <i class="bi bi-buildings-fill display-4 text-primary mb-3"></i>
                            <% } else { %>
                                <i class="bi bi-shop display-4 text-primary mb-3"></i>
                            <% } %>
                            
                            <h5 class="fw-bold <%= malharia.isSede ? 'text-primary' : 'text-dark' %> mb-1"><%= malharia.nome %></h5>
                            <small class="text-muted mb-2"><%= malharia.tipo || 'Setor Padrão' %></small>
                            
                            <div class="mt-auto w-100">
                                <hr class="my-2 border-primary border-opacity-25">
                                <span class="text-success fw-bold fs-5"><%= malharia.total_geral %> <small class="text-muted fs-6">peças no estoque</small></span>
                                <div class="small text-muted mt-1"><%= Object.keys(malharia.processos).length %> Processo(s)</div>
                            </div>
                        </div>
                    </div>
                </div>
            <% }); %>
        </div>
    </div>

    <% estoque.forEach(function(malharia) { %>
        <% const processos = Object.values(malharia.processos); %>
        <div id="view-processos-<%= malharia.id %>" class="view-section d-none">
            <div class="mb-4 d-flex justify-content-between align-items-center border-bottom pb-3 flex-wrap gap-3">
                <div class="d-flex align-items-center gap-3">
                    <button class="btn btn-outline-secondary shadow-sm" onclick="mostrarMalharias()">
                        <i class="bi bi-arrow-left"></i> Voltar
                    </button>
                    <h4 class="m-0 fw-bold text-dark">
                        <i class="bi <%= malharia.isSede ? 'bi-buildings-fill' : 'bi-shop' %> text-primary me-1"></i> <%= malharia.nome %> 
                        <span class="text-muted fw-normal fs-5 mx-2">/</span> 
                        <span class="text-secondary"><i class="bi bi-2-circle"></i> Processos</span>
                    </h4>
                </div>
                
                <% if (processos.length > 0) { %>
                <div class="input-group search-box shadow-sm">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar processo..." onkeyup="pesquisarCards(this, 'lista-processos-<%= malharia.id %>')">
                </div>
                <% } %>
            </div>

            <% if (processos.length === 0) { %>
                <div class="alert alert-secondary text-center py-5 border-dashed bg-light">
                    <i class="bi bi-inbox display-4 text-muted d-block mb-3"></i>
                    <h5 class="text-secondary">Nenhum processo com produção nesta malharia.</h5>
                </div>
            <% } else { %>
                <div class="row g-4" id="lista-processos-<%= malharia.id %>">
                    <% processos.forEach(function(proc) { %>
                        <% 
                            let somaTotal = 0;
                            Object.values(proc.itens).forEach(i => somaTotal += i.total_produzido);
                            let searchData = `${proc.numero_processo || ''} ${proc.orgao || ''}`.toLowerCase();
                        %>
                        <div class="col-sm-6 col-md-4 col-lg-3 item-pesquisavel" data-search="<%= searchData %>">
                            <div class="card h-100 shadow-sm folder-card folder-card-warning bg-white border-warning border-opacity-50" onclick="abrirProdutos('<%= malharia.id %>', '<%= proc.id %>')">
                                <div class="card-body text-center d-flex flex-column justify-content-center align-items-center py-4">
                                    <i class="bi bi-folder2-open display-4 text-warning mb-3"></i>
                                    <h5 class="fw-bold text-dark text-uppercase mb-1"><%= proc.numero_processo || 'S/N' %></h5>
                                    <small class="text-muted mb-3"><i class="bi bi-building"></i> <%= proc.orgao || 'Órgão não informado' %></small>
                                    
                                    <div class="mt-auto w-100">
                                        <hr class="my-2 border-warning border-opacity-25">
                                        <span class="text-success fw-bold fs-5"><%= somaTotal %> <small class="text-muted fs-6">em estoque</small></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>
            <% } %>
        </div>

        <% processos.forEach(function(proc) { %>
            <div id="view-produtos-<%= malharia.id %>-<%= proc.id %>" class="view-section d-none">
                
                <div class="mb-4 d-flex justify-content-between align-items-center border-bottom pb-3 flex-wrap gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <button class="btn btn-outline-secondary shadow-sm" onclick="abrirProcessos('<%= malharia.id %>')">
                            <i class="bi bi-arrow-left"></i> Voltar
                        </button>
                        <h4 class="m-0 fw-bold text-dark">
                            <i class="bi <%= malharia.isSede ? 'bi-buildings-fill' : 'bi-shop' %> text-primary me-1"></i> <%= malharia.nome %> 
                            <span class="text-muted fw-normal fs-5 mx-2">/</span> 
                            <i class="bi bi-folder2-open text-warning me-1"></i> <%= proc.numero_processo || 'S/N' %>
                        </h4>
                    </div>

                    <div class="d-flex gap-2">
                        <% const isSede = malharia.isSede; %>
                        <% const podeTransferir = !isSede || (isSede && locals.user && user.nivel >= 3); %>

                        <% if (podeTransferir) { %>
                            <button id="btn-transf-<%= malharia.id %>-<%= proc.id %>" class="btn btn-primary shadow-sm d-none" onclick="abrirModalMultiplo('<%= malharia.id %>', '<%= proc.id %>', '<%= proc.numero_processo || 'S/N' %>', <%= malharia.isSede %>)">
                                <i class="bi <%= malharia.isSede ? 'bi-box-seam' : 'bi-box-arrow-up-right' %> me-1"></i> 
                                <%= malharia.isSede ? 'Entregar ao Órgão' : 'Dar Baixa / Enviar' %> 
                                <span class="badge bg-white text-primary ms-1" id="badge-transf-<%= malharia.id %>-<%= proc.id %>">0</span>
                            </button>
                        <% } %>

                        <div class="input-group search-box shadow-sm">
                            <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                            <input type="text" class="form-control border-start-0 ps-0" placeholder="Buscar produto..." onkeyup="pesquisarCards(this, 'lista-produtos-<%= malharia.id %>-<%= proc.id %>')">
                        </div>
                    </div>
                </div>

                <div class="row g-3" id="lista-produtos-<%= malharia.id %>-<%= proc.id %>">
                    <% Object.entries(proc.itens).forEach(function([procItemId, item]) { %>
                        <% let searchData = `${item.nome || ''} ${item.descricao || ''} ${item.tamanho || ''}`.toLowerCase(); %>
                        <div class="col-6 col-sm-4 col-md-3 col-xl-2 item-pesquisavel" data-search="<%= searchData %>">
                            <div class="card h-100 shadow-sm produto-card-quadrado bg-white" style="height: auto !important; aspect-ratio: auto; padding-bottom: 10px;">
                                <div class="card-body d-flex flex-column text-center p-2 w-100 justify-content-between h-100">
                                    <div class="mb-2 mt-2">
                                        <h6 class="fw-bold text-primary mb-1" style="font-size: 0.95rem; line-height: 1.2;"><%= item.nome %></h6>
                                        <div class="text-muted produto-desc small" title="<%= item.descricao || 'Sem descrição' %>"><%= item.descricao || 'Sem descrição' %></div>
                                    </div>
                                    <div class="mt-auto pb-2 w-100">
                                        <% if(item.tamanho && item.tamanho !== '-') { %>
                                            <span class="badge bg-secondary mb-1" style="font-size: 0.75rem;">Tam: <%= item.tamanho %></span>
                                        <% } %>
                                        
                                        <div class="produto-qtde fw-bold text-success mt-1"><%= item.total_produzido %></div>
                                        <span class="text-muted small text-uppercase fw-bold d-block mb-1" style="font-size: 0.65rem; letter-spacing: 1px;">Disponível</span>
                                        
                                        <% if (item.entregue && item.entregue > 0) { %>
                                            <span class="badge bg-success bg-opacity-10 text-success border border-success mb-2 shadow-sm" style="font-size: 0.70rem;" title="Peças já despachadas para o Órgão">
                                                <i class="bi bi-check-all"></i> <%= item.entregue %> Entregues
                                            </span>
                                        <% } %>
                                        
                                        <% if (item.em_transito && item.em_transito > 0) { %>
                                            <span class="badge bg-warning text-dark mb-2 shadow-sm" style="font-size: 0.70rem;" title="Aguardando aprovação de Gestor">
                                                <i class="bi bi-hourglass-split"></i> <%= item.em_transito %> em análise
                                            </span>
                                        <% } %>

                                        <% if (podeTransferir && item.total_produzido > 0) { %>
                                            <div class="input-group input-group-sm mt-2 w-100 shadow-sm">
                                                <span class="input-group-text bg-light border-primary border-opacity-25" title="Quantidade para enviar"><i class="bi bi-box-arrow-right text-primary"></i></span>
                                                <input type="number" 
                                                       class="form-control text-center fw-bold text-primary input-transf-<%= malharia.id %>-<%= proc.id %>" 
                                                       data-item-id="<%= item.item_id %>"
                                                       data-processo-item-id="<%= item.processo_item_id_real || '' %>"
                                                       data-item-nome="<%= item.nome %> <%= item.tamanho && item.tamanho !== '-' ? item.tamanho : '' %>"
                                                       max="<%= item.total_produzido %>" 
                                                       min="0" placeholder="0"
                                                       oninput="verificarLimites(this); atualizarBotaoMultiplo('<%= malharia.id %>', '<%= proc.id %>')">
                                            </div>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                </div>

            </div>
        <% }); %>
    <% }); %>

<% } %>

<!-- MODAL TRANSFERÊNCIA -->
<div class="modal fade" id="modalTransferenciaMultipla" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-box-arrow-up-right"></i> <%= locals.user && user.nivel >= 3 ? 'Processar Envio de Estoque' : 'Solicitar Envio de Estoque' %></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            
            <form action="/estoque/transferir" method="POST" enctype="multipart/form-data" id="formTransferencia">
                <div class="modal-body">
                    <input type="hidden" name="malharia_origem_id" id="multi_malharia_id">
                    <input type="hidden" name="processo_id" id="multi_processo_id">
                    <input type="hidden" name="transferencias_json" id="multi_json_data">
                    
                    <p class="text-muted mb-3">Processo: <strong id="multi_processo_nome" class="text-dark"></strong></p>
                    
                    <div class="mb-3">
                        <label class="form-label text-secondary fw-bold small text-uppercase"><i class="bi bi-signpost-split-fill"></i> Destino da Mercadoria</label>
                        <select name="tipo_destino" class="form-select border-primary shadow-sm fw-bold text-primary" id="multi_tipo_destino" required></select>
                    </div>

                    <div class="mb-4 border border-1 border-primary bg-light p-3 rounded">
                        <label class="form-label text-primary fw-bold small text-uppercase">
                            <i class="bi bi-file-earmark-pdf-fill text-danger"></i> Termo de Entrega (PDF) <span class="text-danger">* OBRIGATÓRIO</span>
                        </label>
                        <input type="file" name="documento_termo" class="form-control border-primary shadow-sm" accept="application/pdf" required>
                        <div class="form-text small text-muted">Anexe o documento em PDF referente a este pedido de transferência/baixa.</div>
                    </div>
                    
                    <% if (locals.user && user.nivel < 3) { %>
                        <div class="alert alert-info py-2 small">
                            <i class="bi bi-info-circle-fill"></i> Os itens serão reservados e aguardarão a confirmação de um Gestor para prosseguir.
                        </div>
                    <% } else { %>
                        <div class="alert alert-success py-2 small">
                            <i class="bi bi-check-circle-fill"></i> O estoque será atualizado imediatamente no destino escolhido.
                        </div>
                    <% } %>

                    <div class="list-group list-group-flush border shadow-sm rounded" id="lista_resumo_itens"></div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary px-4" id="btnConfirmarTransf">
                        <i class="bi bi-check-circle"></i> <%= locals.user && user.nivel >= 3 ? 'Confirmar Operação' : 'Solicitar Aprovação' %>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<% if (locals.user && user.nivel < 3 && typeof minhasPendencias !== 'undefined') { %>
<div class="modal fade" id="modalAcompanhamento" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title fw-bold"><i class="bi bi-clock-history"></i> Acompanhar Minhas Solicitações</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <ul class="nav nav-tabs nav-fill bg-light pt-2" id="acompanhamentoTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active fw-bold text-dark" id="pendentes-tab" data-bs-toggle="tab" data-bs-target="#pendentes-pane" type="button" role="tab">
                            Em Análise <span class="badge bg-warning text-dark ms-1"><%= minhasPendencias.length %></span>
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link fw-bold text-dark" id="historico-tab" data-bs-toggle="tab" data-bs-target="#historico-pane" type="button" role="tab">
                            Notificações Recentes <span class="badge bg-secondary ms-1" id="badge-aba-historico"><%= meuHistorico ? meuHistorico.length : 0 %></span>
                        </button>
                    </li>
                </ul>

                <div class="tab-content" id="acompanhamentoTabContent">
                    <div class="tab-pane fade show active p-3" id="pendentes-pane" role="tabpanel">
                        <% if (minhasPendencias.length > 0) { %>
                            <div class="list-group">
                                <% minhasPendencias.forEach(p => { %>
                                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                        <div>
                                            <h6 class="mb-1 fw-bold text-primary"><%= p.item.nome %> <span class="badge bg-light text-dark border"><%= p.tamanho_exato %></span></h6>
                                            <small class="text-muted"><i class="bi bi-folder2-open"></i> Proc: <%= p.processo.numero_processo || 'S/N' %> | <i class="bi bi-shop"></i> <%= p.nome_origem %> ➔ <b class="<%= p.tipo_destino === 'processo' ? 'text-success' : 'text-primary' %>"><%= p.tipo_destino === 'processo' ? 'Órgão Final' : 'Malharia Sede' %></b></small>
                                        </div>
                                        <div class="text-end">
                                            <span class="badge bg-warning text-dark fs-6 shadow-sm" title="Aguardando aprovação"><i class="bi bi-hourglass-split"></i> <%= p.quantidade_solicitada || p.quantidade %> un</span>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-check-circle display-4 d-block mb-2 text-success opacity-50"></i>
                                Tudo certo! Nenhuma solicitação pendente de aprovação.
                            </div>
                        <% } %>
                    </div>

                    <div class="tab-pane fade p-3" id="historico-pane" role="tabpanel">
                        <% if (meuHistorico && meuHistorico.length > 0) { %>
                            <div class="list-group" id="lista-historico">
                                <% meuHistorico.forEach(h => { 
                                    const solicitada = h.quantidade_solicitada || h.quantidade;
                                    const aprovada = h.quantidade;
                                    const devolvida = solicitada - aprovada;
                                %>
                                    <div class="list-group-item list-group-item-action" id="row-hist-<%= h.id %>">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 class="mb-1 fw-bold text-dark"><%= h.item.nome %> <span class="badge bg-light text-dark border"><%= h.tamanho_exato %></span></h6>
                                                <small class="text-muted"><i class="bi bi-folder2-open"></i> Proc: <%= h.processo.numero_processo || 'S/N' %> | <i class="bi bi-shop"></i> <%= h.nome_origem %></small>
                                            </div>
                                            
                                            <div class="d-flex align-items-center gap-2">
                                                <% if (h.status === 'rejeitada') { %>
                                                    <span class="badge bg-danger shadow-sm py-2 px-3"><i class="bi bi-x-circle"></i> Recusado Total</span>
                                                <% } else if (h.status === 'aprovada' && devolvida === 0) { %>
                                                    <span class="badge bg-success shadow-sm py-2 px-3"><i class="bi bi-check-circle"></i> Aceito 100%</span>
                                                <% } else { %>
                                                    <span class="badge bg-info text-dark shadow-sm py-2 px-3"><i class="bi bi-check-circle-half"></i> Aceito Parcialmente</span>
                                                <% } %>
                                                
                                                <button type="button" class="btn btn-sm btn-outline-secondary border-0" onclick="arquivarNotificacao('<%= h.id %>')" title="Arquivar notificação lida">
                                                    <i class="bi bi-archive fs-5"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="bg-light p-2 rounded small d-flex gap-3 border flex-wrap">
                                            <span class="text-secondary"><i class="bi bi-box-arrow-right"></i> <b>Pediu:</b> <%= solicitada %></span>
                                            <% if (h.status === 'rejeitada') { %>
                                                <span class="text-danger"><i class="bi bi-arrow-return-left"></i> <b>Devolvido:</b> <%= solicitada %> un</span>
                                            <% } else if (devolvida > 0) { %>
                                                <span class="text-success"><i class="bi bi-check-all"></i> <b><%= h.tipo_destino === 'processo' ? 'Entregue no Órgão' : 'Entrou na Sede' %>:</b> <%= aprovada %> un</span>
                                                <span class="text-danger"><i class="bi bi-arrow-return-left"></i> <b>Devolvido:</b> <%= devolvida %> un</span>
                                            <% } else { %>
                                                <span class="text-success"><i class="bi bi-check-all"></i> <b><%= h.tipo_destino === 'processo' ? 'Entregue no Órgão' : 'Entrou na Sede' %>:</b> <%= aprovada %> un</span>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-4 d-block mb-2 opacity-50"></i>
                                Nenhuma notificação nova.
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar Painel</button>
            </div>
        </div>
    </div>
</div>
<% } %>

<% if (locals.user && user.nivel >= 3 && typeof transferenciasPendentes !== 'undefined' && transferenciasPendentes.length > 0) { %>
    <div class="modal fade" id="modalAprovacoes" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-xl">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-warning text-dark">
                    <h5 class="modal-title fw-bold"><i class="bi bi-ui-checks"></i> Aprovar Saída de Estoque</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="tabela-aprovacoes">
                            <thead class="table-light">
                                <tr>
                                    <th class="ps-4">Origem</th>
                                    <th>Processo</th>
                                    <th>Item / Tamanho</th>
                                    <th>Destino Solicitado</th>
                                    <th>Termo (PDF)</th>
                                    <th class="text-center" style="width: 140px;">Qtd. Aprovada</th>
                                    <th class="text-center pe-4" style="width: 120px;">Ação</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% transferenciasPendentes.forEach(t => { %>
                                    <tr id="row-transf-<%= t.id %>">
                                        <td class="ps-4 fw-bold text-secondary"><%= t.nome_origem %></td>
                                        <td><%= t.processo.numero_processo || 'S/N' %></td>
                                        <td><%= t.item.nome %> <span class="badge bg-secondary ms-1"><%= t.tamanho_exato %></span></td>
                                        
                                        <td>
                                            <% if (t.tipo_destino === 'processo') { %>
                                                <span class="badge bg-success bg-opacity-10 text-success border border-success"><i class="bi bi-box-seam"></i> Entrega Órgão</span>
                                            <% } else { %>
                                                <span class="badge bg-primary bg-opacity-10 text-primary border border-primary"><i class="bi bi-buildings"></i> Malharia Sede</span>
                                            <% } %>
                                            <div class="small text-muted mt-1"><i class="bi bi-person"></i> <%= t.solicitante ? t.solicitante.nome : 'Usuário' %></div>
                                        </td>

                                        <td>
                                            <% if (t.documento_termo) { %>
                                                <a href="<%= t.documento_termo %>" target="_blank" class="btn btn-sm btn-outline-danger">
                                                    <i class="bi bi-file-earmark-pdf"></i> Ver PDF
                                                </a>
                                            <% } else { %>
                                                <span class="text-muted small">Sem PDF</span>
                                            <% } %>
                                        </td>
                                        
                                        <td class="text-center">
                                            <input type="number" id="qtd-aprov-<%= t.id %>" class="form-control form-control-sm text-center fw-bold text-success border-success" 
                                                   value="<%= t.quantidade %>" min="1" max="<%= t.quantidade %>" title="Você pode reduzir a quantidade se necessário">
                                        </td>
                                        
                                        <td class="text-center pe-4">
                                            <div class="btn-group shadow-sm">
                                                <button type="button" id="btn-aprov-<%= t.id %>" class="btn btn-sm btn-success" title="Aprovar e processar o destino" onclick="processarAprovacao('<%= t.id %>', 'aprovar')">
                                                    <i class="bi bi-check-lg fw-bold"></i>
                                                </button>
                                                <button type="button" id="btn-rejeita-<%= t.id %>" class="btn btn-sm btn-danger border-start-0" title="Rejeitar e devolver para origem" onclick="processarAprovacao('<%= t.id %>', 'rejeitar')">
                                                    <i class="bi bi-x-lg fw-bold"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer bg-light justify-content-between">
                    <span class="text-muted small"><i class="bi bi-info-circle"></i> As aprovações são salvas imediatamente sem recarregar a tela. Ao fechar, recarregue a página para ver os estoques atualizados.</span>
                    <button type="button" class="btn btn-secondary" onclick="window.location.reload();">Fechar e Atualizar Estoque</button>
                </div>
            </div>
        </div>
    </div>
<% } %>

<script>
    function ocultarTodasAsTelas() {
        document.querySelectorAll('.view-section').forEach(el => el.classList.add('d-none'));
        document.querySelectorAll('.search-box input').forEach(input => input.value = '');
        document.querySelectorAll('.item-pesquisavel').forEach(el => el.style.display = '');
    }

    function mostrarMalharias() {
        ocultarTodasAsTelas();
        document.getElementById('view-malharias').classList.remove('d-none');
    }

    function abrirProcessos(malhariaId) {
        ocultarTodasAsTelas();
        document.getElementById('view-processos-' + malhariaId).classList.remove('d-none');
    }

    function abrirProdutos(malhariaId, processoId) {
        ocultarTodasAsTelas();
        document.getElementById('view-produtos-' + malhariaId + '-' + processoId).classList.remove('d-none');
    }

    function pesquisarCards(inputElement, containerId) {
        const termo = inputElement.value.toLowerCase().trim();
        const container = document.getElementById(containerId);
        const cards = container.querySelectorAll('.item-pesquisavel');
        cards.forEach(card => card.style.display = card.getAttribute('data-search').includes(termo) ? '' : 'none');
    }

    function verificarLimites(input) {
        let max = parseInt(input.getAttribute('max'));
        let val = parseInt(input.value);
        if (val < 0) input.value = 0;
        if (val > max) input.value = max;
    }

    function atualizarBotaoMultiplo(malhariaId, processoId) {
        const inputs = document.querySelectorAll(`.input-transf-${malhariaId}-${processoId}`);
        let totalItens = 0;
        inputs.forEach(input => {
            const val = parseInt(input.value);
            if (val > 0) totalItens += val;
        });
        const btn = document.getElementById(`btn-transf-${malhariaId}-${processoId}`);
        const badge = document.getElementById(`badge-transf-${malhariaId}-${processoId}`);
        if (totalItens > 0) {
            badge.innerText = totalItens;
            btn.classList.remove('d-none');
        } else {
            btn.classList.add('d-none');
        }
    }

    function abrirModalMultiplo(malhariaId, processoId, nomeProcesso, isSede) {
        document.getElementById('multi_malharia_id').value = malhariaId;
        document.getElementById('multi_processo_id').value = processoId;
        document.getElementById('multi_processo_nome').innerText = nomeProcesso;
        
        const selectDestino = document.getElementById('multi_tipo_destino');
        if (isSede) {
            selectDestino.innerHTML = '<option value="processo">✅ Entregar para o Órgão Final (Baixa Definitiva do Estoque)</option>';
        } else {
            selectDestino.innerHTML = `
                <option value="sede">🏢 Enviar para Malharia Sede (Armazenamento Temporário)</option>
                <option value="processo">✅ Entregar para o Órgão Final (Baixa Definitiva do Estoque)</option>
            `;
        }

        const inputs = document.querySelectorAll(`.input-transf-${malhariaId}-${processoId}`);
        const listaResumo = document.getElementById('lista_resumo_itens');
        listaResumo.innerHTML = ''; 
        let arrayTransferencias = [];

        inputs.forEach(input => {
            const quantidade = parseInt(input.value);
            if (quantidade > 0) {
                const itemId = input.getAttribute('data-item-id');
                const procItemId = input.getAttribute('data-processo-item-id');
                const itemNome = input.getAttribute('data-item-nome');
                
                listaResumo.innerHTML += `
                    <div class="list-group-item d-flex justify-content-between align-items-center bg-white">
                        <span class="text-secondary fw-bold">${itemNome}</span>
                        <span class="badge bg-success rounded-pill fs-6">${quantidade} un</span>
                    </div>
                `;
                arrayTransferencias.push({ item_id: itemId, processo_item_id: procItemId || null, quantidade: quantidade });
            }
        });

        document.getElementById('multi_json_data').value = JSON.stringify(arrayTransferencias);
        var myModal = new bootstrap.Modal(document.getElementById('modalTransferenciaMultipla'));
        myModal.show();
    }

    document.getElementById('formTransferencia').addEventListener('submit', function(e) {
        const btn = document.getElementById('btnConfirmarTransf');
        setTimeout(() => {
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processando...';
        }, 50);
    });

    async function processarAprovacao(idTransferencia, acao) {
        if (acao === 'rejeitar' && !confirm('Devolver a mercadoria para a origem?')) return;

        const qtdAprovada = document.getElementById(`qtd-aprov-${idTransferencia}`).value;
        const btnAprov = document.getElementById(`btn-aprov-${idTransferencia}`);
        const btnRej = document.getElementById(`btn-rejeita-${idTransferencia}`);
        
        btnAprov.disabled = true; btnRej.disabled = true;
        if (acao === 'aprovar') btnAprov.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';
        if (acao === 'rejeitar') btnRej.innerHTML = '<span class="spinner-border spinner-border-sm"></span>';

        const params = new URLSearchParams();
        params.append('id_transferencia', idTransferencia);
        if (acao === 'aprovar') params.append('quantidade_aprovada', qtdAprovada);

        try {
            const res = await fetch(`/estoque/${acao}`, {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body: params
            });

            const data = await res.json();
            
            if (data.success) {
                const row = document.getElementById(`row-transf-${idTransferencia}`);
                row.classList.add('fade-out-row');
                setTimeout(() => {
                    row.remove();
                    atualizarContadorTabela();
                }, 400);
            } else {
                throw new Error("Falha na operação.");
            }
        } catch (error) {
            alert('Erro ao processar solicitação. Tente novamente.');
            btnAprov.disabled = false; btnRej.disabled = false;
            btnAprov.innerHTML = '<i class="bi bi-check-lg fw-bold"></i>';
            btnRej.innerHTML = '<i class="bi bi-x-lg fw-bold"></i>';
        }
    }

    function atualizarContadorTabela() {
        const tabela = document.getElementById('tabela-aprovacoes');
        if (!tabela) return;
        
        const linhasRestantes = tabela.querySelectorAll('tbody tr').length;
        const contadorSpan = document.getElementById('contador-pendencias');
        
        if (linhasRestantes === 0) {
            const alerta = document.getElementById('alerta-aprovacoes');
            if (alerta) alerta.style.display = 'none';
            
            const modalEl = document.getElementById('modalAprovacoes');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
            
            window.location.reload();
        } else if (contadorSpan) {
            contadorSpan.innerText = linhasRestantes;
        }
    }

    async function arquivarNotificacao(idTransferencia) {
        try {
            const params = new URLSearchParams();
            params.append('id_transferencia', idTransferencia);

            const res = await fetch(`/estoque/arquivar`, {
                method: 'POST',
                headers: { 'Accept': 'application/json' },
                body: params
            });

            const data = await res.json();

            if (data.success) {
                const row = document.getElementById(`row-hist-${idTransferencia}`);
                if (row) {
                    row.classList.add('fade-out-row');
                    setTimeout(() => {
                        row.remove();
                        const badgeAba = document.getElementById('badge-aba-historico');
                        const badgeFora = document.getElementById('contador-historico-badge');
                        
                        if (badgeAba) {
                            let qtd = parseInt(badgeAba.innerText) - 1;
                            badgeAba.innerText = qtd > 0 ? qtd : 0;
                            if(badgeFora) badgeFora.innerText = qtd > 0 ? qtd : 0;
                            
                            if (qtd <= 0) {
                                document.getElementById('lista-historico').innerHTML = `
                                    <div class="text-center py-4 text-muted">
                                        <i class="bi bi-inbox display-4 d-block mb-2 opacity-50"></i>
                                        Nenhuma notificação nova.
                                    </div>
                                `;
                            }
                        }
                    }, 400);
                }
            } else {
                throw new Error("Erro na API.");
            }
        } catch (error) {
            alert('Falha ao arquivar a notificação. Tente novamente.');
        }
    }
</script>