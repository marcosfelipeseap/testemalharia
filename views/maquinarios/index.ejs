<div class="d-flex justify-content-between pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2">Maquinários</h1>
    
    <% if (user.nivel >= 3) { %>
    <div>
        <a href="/maquinarios/tipos" class="btn btn-outline-secondary btn-sm me-2">
            <i class="bi bi-tags"></i> Gerenciar Tipos
        </a>
        <a href="/maquinarios/create" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-lg"></i> Novo Maquinário
        </a>
    </div>
    <% } %>
</div>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="inputBusca" class="form-control border-start-0 ps-0" 
                   placeholder="Digite para pesquisar máquinas..." value="<%= busca %>" autocomplete="off">
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nome da Máquina</th>
                    <th>Tipo</th>
                    <% if (user.nivel >= 3) { %>
                        <th class="text-end" style="width: 150px;">Ações</th>
                    <% } %>
                </tr>
            </thead>
            <tbody id="tabelaMaquinas">
                <% if (maquinas.length === 0) { %>
                    <tr>
                        <td colspan="<%= user.nivel >= 3 ? '3' : '2' %>" class="text-center text-muted py-3">
                            Nenhuma máquina encontrada.
                        </td>
                    </tr>
                <% } else { %>
                    <% maquinas.forEach(m => { %>
                        <tr>
                            <td class="fw-bold"><%= m.nome %></td>
                            <td>
                                <% if (m.tipo) { %>
                                    <span class="badge bg-secondary"><%= m.tipo.nome %></span>
                                <% } else { %>
                                    <span class="text-muted small">- Sem tipo -</span>
                                <% } %>
                            </td>
                            <% if (user.nivel >= 3) { %>
                            <td class="text-end">
                                <a href="/maquinarios/<%= m.id %>/edit" class="btn btn-sm btn-outline-primary" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="abrirModalExclusao('<%= m.id %>', '<%= m.nome %>')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                            <% } %>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<% if (user.nivel >= 3) { %>
<div class="modal fade" id="modalExcluirMaquina" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar Exclusão</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-1">Tem certeza que deseja excluir a máquina:</p>
                <h5 id="nomeMaquinaExcluir" class="fw-bold"></h5>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formExcluirMaquina" method="POST" action="">
                    <button type="submit" class="btn btn-danger px-4">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>
<% } %>

<script>
    // Passa o nível do usuário para o JavaScript para controlar a busca dinâmica
    const userNivel = <%= user.nivel %>;
    let timeout = null;
    const inputBusca = document.getElementById('inputBusca');
    const tabela = document.getElementById('tabelaMaquinas');

    inputBusca.addEventListener('input', function() {
        const termo = this.value;
        clearTimeout(timeout);
        timeout = setTimeout(async () => {
            try {
                const res = await fetch(`/maquinarios?busca=${encodeURIComponent(termo)}`, {
                    headers: { 'Accept': 'application/json' }
                });
                if (res.ok) {
                    const data = await res.json();
                    atualizarTabela(data.maquinas);
                }
            } catch (error) { console.error("Erro na busca:", error); }
        }, 300);
    });

    function atualizarTabela(lista) {
        if (!lista || lista.length === 0) {
            tabela.innerHTML = `<tr><td colspan="${userNivel >= 3 ? '3' : '2'}" class="text-center text-muted py-3">Nenhuma máquina encontrada.</td></tr>`;
            return;
        }
        const html = lista.map(m => `
            <tr>
                <td class="fw-bold">${m.nome}</td>
                <td>${m.tipo ? `<span class="badge bg-secondary">${m.tipo.nome}</span>` : '<span class="text-muted small">- Sem tipo -</span>'}</td>
                ${userNivel >= 3 ? `
                    <td class="text-end">
                        <a href="/maquinarios/${m.id}/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                        <button type="button" class="btn btn-sm btn-outline-danger" onclick="abrirModalExclusao('${m.id}', '${m.nome}')">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                ` : ''}
            </tr>
        `).join('');
        tabela.innerHTML = html;
    }

    <% if (user.nivel >= 3) { %>
    function abrirModalExclusao(id, nome) {
        const modalEl = document.getElementById('modalExcluirMaquina');
        document.getElementById('nomeMaquinaExcluir').innerText = nome;
        document.getElementById('formExcluirMaquina').action = `/maquinarios/${id}/delete`;
        new bootstrap.Modal(modalEl).show();
    }
    <% } %>
</script>