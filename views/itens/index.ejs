<div class="d-flex justify-content-between pt-3 pb-2 mb-3 border-bottom">
    <h1 class="h2"><%= user.nivel >= 3 ? 'Itens / Produtos' : 'Itens Disponíveis' %></h1>
    
    <% if (user.nivel >= 3) { %>
    <a href="/itens/create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg"></i> Novo Item
    </a>
    <% } %>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<div class="row mb-3">
    <div class="col-md-6">
        <div class="input-group">
            <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
            <input type="text" id="inputBusca" class="form-control border-start-0 ps-0" 
                   placeholder="Digite para pesquisar produtos..." value="<%= busca %>" autocomplete="off">
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Nome do Produto</th>
                    <th class="text-center" style="width: 150px;">Meta / Maq.</th>
                    <th>Máquinas Habilitadas</th>
                    <% if (user.nivel >= 3) { %>
                        <th class="text-end" style="width: 150px;">Ações</th>
                    <% } %>
                </tr>
            </thead>
            <tbody id="tabelaItens">
                <% if (itens.length === 0) { %>
                    <tr><td colspan="<%= user.nivel >= 3 ? '4' : '3' %>" class="text-center text-muted py-3">Nenhum item cadastrado.</td></tr>
                <% } else { %>
                    <% itens.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="fw-bold"><%= item.nome %></div>
                                <small class="text-muted"><%= item.descricao || '' %></small>
                            </td>
                            <td class="text-center">
                                <span class="badge bg-success fs-6"><%= item.meta_diaria || 0 %></span>
                                <div class="small text-muted">unid/dia</div>
                            </td>
                            <td>
                                <% if (item.maquinas && item.maquinas.length > 0) { %>
                                    <div class="d-flex flex-wrap gap-1">
                                        <% item.maquinas.forEach(v => { %>
                                            <span class="badge bg-secondary border">
                                                <i class="bi bi-gear-fill"></i> <%= v.maquina ? v.maquina.nome : '?' %>
                                            </span>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <span class="text-muted small fst-italic">Nenhuma vinculada</span>
                                <% } %>
                            </td>
                            <% if (user.nivel >= 3) { %>
                            <td class="text-end">
                                <a href="/itens/<%= item.id %>/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                                <button type="button" class="btn btn-sm btn-outline-danger" 
                                        onclick="abrirModalExclusao('<%= item.id %>', '<%= item.nome %>')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                            <% } %>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<% if (user.nivel >= 3) { %>
<div class="modal fade" id="modalExcluirItem" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-danger">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title">Confirmar Exclusão</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <p class="mb-1">Tem certeza que deseja excluir o produto:</p>
                <h5 id="nomeItemExcluir" class="fw-bold"></h5>
                <p class="text-muted small mb-0">Esta ação não pode ser desfeita.</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <form id="formExcluirItem" method="POST" action="">
                    <button type="submit" class="btn btn-danger px-4">Sim, Excluir</button>
                </form>
            </div>
        </div>
    </div>
</div>
<% } %>

<script>
    const userNivel = <%= user.nivel %>;
    let timeout = null;
    const inputBusca = document.getElementById('inputBusca');
    const tabela = document.getElementById('tabelaItens');

    inputBusca.addEventListener('input', function() {
        const termo = this.value;
        clearTimeout(timeout);
        
        timeout = setTimeout(async () => {
            try {
                const res = await fetch(`/itens?busca=${encodeURIComponent(termo)}`, {
                    headers: { 'Accept': 'application/json' }
                });
                
                if (res.ok) {
                    const data = await res.json();
                    atualizarTabela(data.itens);
                }
            } catch (error) {
                console.error("Erro na busca:", error);
            }
        }, 300);
    });

    function atualizarTabela(lista) {
        if (!lista || lista.length === 0) {
            tabela.innerHTML = `<tr><td colspan="${userNivel >= 3 ? '4' : '3'}" class="text-center text-muted py-3">Nenhum item encontrado.</td></tr>`;
            return;
        }

        const html = lista.map(item => {
            let maquinasHtml = '<span class="text-muted small fst-italic">Nenhuma vinculada</span>';
            if (item.maquinas && item.maquinas.length > 0) {
                maquinasHtml = '<div class="d-flex flex-wrap gap-1">' + 
                    item.maquinas.map(v => `
                        <span class="badge bg-secondary border">
                            <i class="bi bi-gear-fill"></i> ${v.maquina ? v.maquina.nome : '?'}
                        </span>
                    `).join('') + 
                    '</div>';
            }

            let acoesHtml = '';
            if (userNivel >= 3) {
                acoesHtml = `
                <td class="text-end">
                    <a href="/itens/${item.id}/edit" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                    <button type="button" class="btn btn-sm btn-outline-danger" 
                            onclick="abrirModalExclusao('${item.id}', '${item.nome}')">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>`;
            }

            return `
                <tr>
                    <td>
                        <div class="fw-bold">${item.nome}</div>
                        <small class="text-muted">${item.descricao || ''}</small>
                    </td>
                    <td class="text-center">
                        <span class="badge bg-success fs-6">${item.meta_diaria || 0}</span>
                        <div class="small text-muted">unid/dia</div>
                    </td>
                    <td>${maquinasHtml}</td>
                    ${acoesHtml}
                </tr>
            `;
        }).join('');

        tabela.innerHTML = html;
    }

    <% if (user.nivel >= 3) { %>
    function abrirModalExclusao(id, nome) {
        const modalEl = document.getElementById('modalExcluirItem');
        const nomeEl = document.getElementById('nomeItemExcluir');
        const formEl = document.getElementById('formExcluirItem');

        nomeEl.innerText = nome;
        formEl.action = `/itens/${id}/delete`;

        new bootstrap.Modal(modalEl).show();
    }
    <% } %>
</script>