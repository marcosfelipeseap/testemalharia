<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro - Sistema de Malharia</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    
    <div class="card p-4 shadow-lg border-0" style="width: 100%; max-width: 450px; border-radius: 12px;">
        <div class="text-center mb-4">
            <img src="/img/logo.png" alt="Logo" width="130" class="mb-3" onerror="this.style.display='none'">
           
            <h3 class="fw-bold text-dark">Solicitar Acesso</h3>
            <p class="text-muted">Preencha os dados para criar sua conta</p>
        </div>
        
        <% if (error) { %> 
            <div class="alert alert-danger py-2 text-center"><%= error %></div> 
        <% } %>

        <form action="/auth/register" method="POST">
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">Nome Completo</label>
                <input type="text" name="nome" class="form-control bg-light" placeholder="Ex: João da Silva" required>
            </div>
            
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">E-mail</label>
                <input type="email" name="email" class="form-control bg-light" placeholder="Ex: joao@email.com" required>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary">Usuário (Login)</label>
                <input type="text" name="username" class="form-control bg-light" 
                       pattern="[a-zA-Z0-9_]+" 
                       title="Apenas letras, números e underline (_). Sem espaços ou acentos."
                       placeholder="Ex: joao_silva"
                       oninput="this.value = this.value.replace(/[^a-zA-Z0-9_]/g, '')" required>
                <div class="form-text text-muted small">Sem espaços ou acentos. Usado para entrar no sistema.</div>
            </div>
            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">Senha</label>
                <input type="password" name="password" class="form-control bg-light" placeholder="Crie uma senha segura" required>
            </div>
            <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">Solicitar Cadastro</button>
        </form>
        
        <div class="mt-4 text-center">
            <a href="/auth/login" class="text-decoration-none text-secondary fw-semibold">
                &larr; Voltar ao Login
            </a>
        </div>
    </div>

</body>
</html>