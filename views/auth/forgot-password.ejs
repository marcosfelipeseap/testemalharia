<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar Senha</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body class="bg-light d-flex align-items-center justify-content-center min-vh-100 py-4">
    <div class="card p-4 shadow-lg border-0" style="width: 100%; max-width: 400px; border-radius: 12px;">
        <div class="text-center mb-4">
            <h3 class="fw-bold text-dark">Recuperar Senha</h3>
            <p class="text-muted small">Informe seu e-mail e enviaremos um link de recuperação.</p>
        </div>
        
        <% if (error) { %> <div class="alert alert-danger py-2 text-center"><%= error %></div> <% } %>
        <% if (success) { %> <div class="alert alert-success py-2 text-center"><%= success %></div> <% } %>

        <form action="/auth/forgot-password" method="POST">
            <div class="mb-4">
                <label class="form-label fw-semibold text-secondary">E-mail Cadastrado</label>
                <input type="email" name="email" class="form-control bg-light" placeholder="Ex: joao@email.com" required>
            </div>
            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold">Enviar Link de Recuperação</button>
        </form>
        
        <div class="mt-4 text-center">
            <a href="/auth/login" class="text-decoration-none text-secondary fw-semibold">&larr; Voltar ao Login</a>
        </div>
    </div>
</body>
</html>